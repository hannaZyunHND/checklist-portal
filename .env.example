# Firebase Web App Configuration (Spark Free Plan)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Danh sách email được tự động gán vai trò PD khi đăng ký (phân cách bằng dấu phẩy)
VITE_BOOTSTRAP_PD_EMAILS=pd.manager@example.com

# Google Apps Script Web App URL (dùng để gửi email thông báo miễn phí)
VITE_GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GAS_SECRET=joytime-secret-change-me

# Cloudflare R2 — Phương án KHUYẾN NGHỊ cho GitHub Pages (qua Cloudflare Worker miễn phí, KHÔNG lộ secret key)
VITE_R2_WORKER_URL=
VITE_R2_WORKER_SECRET=

# Cloudflare R2 Direct S3 (Chỉ dùng test local trong .env.local — KHÔNG đưa SECRET_KEY lên GitHub Pages public)
VITE_R2_ENDPOINT=
VITE_R2_BUCKET=
VITE_R2_ACCESS_KEY=
VITE_R2_SECRET_KEY=
VITE_R2_PUBLIC_URL=
