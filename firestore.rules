rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc(request.auth.uid).role == 'MANAGER' || userDoc(request.auth.uid).role == 'PD');
    }

    function appConfigExists() {
      return exists(/databases/$(database)/documents/config/app);
    }

    function appConfigData() {
      return get(/databases/$(database)/documents/config/app).data;
    }

    function isBootstrapManagerEmail() {
      return appConfigExists()
        && ('bootstrapPdEmails' in appConfigData())
        && request.auth.token.email != null
        && request.auth.token.email.lower() in appConfigData().bootstrapPdEmails;
    }

    function isValidManagerInvite() {
      return appConfigExists()
        && ('pdInviteCode' in appConfigData())
        && appConfigData().pdInviteCode != ''
        && ('inviteCodeUsed' in request.resource.data)
        && request.resource.data.inviteCodeUsed == appConfigData().pdInviteCode;
    }

    function isTicketReviewer(ticketData) {
      return ('reviewerId' in ticketData && ticketData.reviewerId == request.auth.uid)
        || (!('reviewerId' in ticketData) && ticketData.createdBy == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (
          isManager()
          || (
            request.auth.uid == uid
            && (
              request.resource.data.role == 'STAFF'
              || request.resource.data.role == 'OM'
              || (
                (request.resource.data.role == 'MANAGER' || request.resource.data.role == 'PD')
                && (isBootstrapManagerEmail() || isValidManagerInvite())
              )
            )
          )
        );
      allow update: if isManager()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
        );
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isTicketReviewer(resource.data)
          || (
            (
              request.auth.uid in resource.data.assigneeIds
              || ('listingAssigneeId' in resource.data && resource.data.listingAssigneeId == request.auth.uid)
              || ('goliveAssigneeId' in resource.data && resource.data.goliveAssigneeId == request.auth.uid)
            )
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.groupType == resource.data.groupType
            && request.resource.data.assigneeIds == resource.data.assigneeIds
            && request.resource.data.deadline == resource.data.deadline
          )
        );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /history/{historyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid;
      }

      match /attachments/{attachmentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid;
      }
    }

    match /emailLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
